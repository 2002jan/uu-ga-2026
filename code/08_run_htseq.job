#!/bin/bash
#SBATCH -A uppmax2026-1-61
#SBATCH -J htseq_count
#SBATCH --output=logs/htseq_%j.out
#SBATCH --error=logs/htseq_%j.err
#SBATCH -n 1
#SBATCH -t 10:00:00

#Modules
module load HTSeq/2.1.2-gfbf-2024a
module load SAMtools/1.22.1-GCC-13.3.0

#Dir preperation
WORKDIR=$HOME/GenomeAnalysisProject

BAM_DIR=$WORKDIR/results/rna_seq_alignment
GFF=$WORKDIR/results/prokka_annotation/EnterococcusFaecium.gff
OUT_DIR=$WORKDIR/results/htseq_counts
mkdir -p ${OUT_DIR}/{BH,Serum}

cd $SNIC_TMP

mkdir data
mkdir -p out/{BH,Serum}

cp $GFF data/annotation_raw.gff
sed '/^##FASTA/,$d' data/annotation_raw.gff > data/annotation.gff #Removes fasta segment from the end of the file

count_sample() {
  local SAMPLE=$1
  local CONDITION=$2
  local BAM=${BAM_DIR}/${CONDITION}/${SAMPLE}.sorted.bam
  local TMP_OUT=out/${CONDITION}

  echo "[$(date)] Counting ${CONDITION}/${SAMPLE}..."

  cp ${BAM} ${TMP_OUT}/${SAMPLE}.sorted.bam
  cp ${BAM}.bai ${TMP_OUT}/${SAMPLE}.sorted.bam.bai

  samtools view -f 1 -b \
    ${TMP_OUT}/${SAMPLE}.sorted.bam \
    -o ${TMP_OUT}/${SAMPLE}.paired.bam

  samtools view -F 1 -b \
    ${TMP_OUT}/${SAMPLE}.sorted.bam \
    -o ${TMP_OUT}/${SAMPLE}.single.bam

  samtools index ${TMP_OUT}/${SAMPLE}.paired.bam
  samtools index ${TMP_OUT}/${SAMPLE}.single.bam

  local PAIRED_READS=$(samtools view -c -f 1 ${TMP_OUT}/${SAMPLE}.paired.bam)
  local SINGLE_READS=$(samtools view -c -F 1 ${TMP_OUT}/${SAMPLE}.single.bam)

  echo "  Paired reads : ${PAIRED_READS}"
  echo "  Single reads : ${SINGLE_READS}"

  htseq-count \
    --format bam \
    --order pos \
    --stranded reverse \
    --minaqual 20 \
    --type CDS \
    --idattr ID \
    --additional-attr Name \
    --mode union \
    --counts_output ${TMP_OUT}/${SAMPLE}.counts_paired.tsv \
    ${TMP_OUT}/${SAMPLE}.paired.bam \
    data/annotation.gff

  htseq-count \
    --format bam \
    --order pos \
    --stranded reverse \
    --minaqual 20 \
    --type CDS \
    --idattr ID \
    --additional-attr Name \
    --mode union \
    --counts_output ${TMP_OUT}/${SAMPLE}.counts_single.tsv \
    ${TMP_OUT}/${SAMPLE}.single.bam \
    data/annotation.gff

  paste \
    ${TMP_OUT}/${SAMPLE}.counts_paired.tsv \
    ${TMP_OUT}/${SAMPLE}.counts_single.tsv \
  | awk 'BEGIN{OFS="\t"} {
      if ($1 != $3) {
        print "ERROR: gene ID mismatch at line "NR": "$1" vs "$3 > "/dev/stderr"
        exit 1
      }
      print $1, $2+$4
    }' \
  > ${TMP_OUT}/${SAMPLE}.counts.tsv

  rm -f \
    ${TMP_OUT}/${SAMPLE}.sorted.bam \
    ${TMP_OUT}/${SAMPLE}.sorted.bam.bai \
    ${TMP_OUT}/${SAMPLE}.paired.bam \
    ${TMP_OUT}/${SAMPLE}.paired.bam.bai \
    ${TMP_OUT}/${SAMPLE}.single.bam \
    ${TMP_OUT}/${SAMPLE}.single.bam.bai

  echo "[$(date)] Done: ${CONDITION}/${SAMPLE}"
}

echo "[$(date)] Gathering samples..."

BH_SAMPLES=($(ls ${BAM_DIR}/BH/*.sorted.bam 2>/dev/null \
  | xargs -n1 basename | sed 's/\.sorted\.bam//'))

SERUM_SAMPLES=($(ls ${BAM_DIR}/Serum/*.sorted.bam 2>/dev/null \
  | xargs -n1 basename | sed 's/\.sorted\.bam//'))

echo "BH samples (${#BH_SAMPLES[@]}): ${BH_SAMPLES[*]}"
echo "Serum samples (${#SERUM_SAMPLES[@]}): ${SERUM_SAMPLES[*]}"

for SAMPLE in "${BH_SAMPLES[@]}"; do 
    count_sample "$SAMPLE" "BH";
done

for SAMPLE in "${SERUM_SAMPLES[@]}"; do
    count_sample "$SAMPLE" "Serum";
done

MATRIX=out/count_matrix.tsv

ALL_COUNT_FILES=()
ALL_HEADERS=("GeneID")

for SAMPLE in "${BH_SAMPLES[@]}"; do
  ALL_COUNT_FILES+=("out/BH/${SAMPLE}.counts.tsv")
  ALL_HEADERS+=("BH_${SAMPLE}")
done

for SAMPLE in "${SERUM_SAMPLES[@]}"; do
  ALL_COUNT_FILES+=("out/Serum/${SAMPLE}.counts.tsv")
  ALL_HEADERS+=("Serum_${SAMPLE}")
done

echo -e "$(IFS=$'\t'; echo "${ALL_HEADERS[*]}")" > ${MATRIX}

paste "${ALL_COUNT_FILES[@]}" \
  | awk 'BEGIN{OFS="\t"} !/^__/ {
      printf $1;
      for (i=2; i<=NF; i+=2) printf "\t"$i;   # keep only count col, skip duplicate ID cols
      printf "\n"
    }' \
  >> ${MATRIX}

SUMMARY=out/htseq_summary.tsv
echo -e "Metric\t$(IFS=$'\t'; echo "${ALL_HEADERS[@]:1}")" > ${SUMMARY}

for METRIC in __no_feature __ambiguous __too_low_aQual __not_aligned __alignment_not_unique; do
  ROW="$METRIC"
  for FILE in "${ALL_COUNT_FILES[@]}"; do
    VAL=$(grep "^${METRIC}" ${FILE} | awk '{print $2}')
    ROW="${ROW}\t${VAL:-0}"
  done
  echo -e "$ROW" >> ${SUMMARY}
done

cp out/BH/*.tsv ${OUT_DIR}/BH/
cp out/Serum/*.tsv ${OUT_DIR}/Serum/
cp ${MATRIX} ${OUT_DIR}/count_matrix.tsv
cp ${SUMMARY} ${OUT_DIR}/htseq_summary.tsv
